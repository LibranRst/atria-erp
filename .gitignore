# Track project governance and skills; keep machine-local agent state private.
.agents/*
!.agents/README.md
!.agents/hooks.json
!.agents/skills.json
!.agents/rules/
!.agents/rules/**
!.agents/skills/
!.agents/skills/**

.claude/*
.omp/
**/.obsidian/workspace*.json
node_modules/
.env
.env.local
.DS_Store

# Next.js dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Di-anchor ke root sebelum aplikasi pindah ke apps/web; pola tanpa slash awal
# berlaku di setiap kedalaman sehingga output build monorepo ikut terabaikan.
.next/
out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# `.env.example` carries no secrets and is the only record of which variables
# the app needs. Without this exception `.env*` swallows it, so a fresh clone
# has no way to learn about ATRIA_BOOTSTRAP_SECRET or ATRIA_TEST_DATABASE_URL.
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local caches and scratch files
.pnpm-store/
.playwright-cli/
output/
scratch/
.atria-demo/

# storybook
storybook-static/

# design-sync working state (converter scripts, reference build, staged deps)
.ds-sync/
.design-sync/sb-reference/
.design-sync/dts-out/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
ds-bundle/

# build output paket & aplikasi di monorepo
apps/web/dist/
.expo/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
