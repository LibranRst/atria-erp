{
  "name": "atria-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @atria/web dev",
    "dev:default": "bun --filter @atria/web dev:default",
    "build": "bun --filter @atria/web build",
    "start": "bun --filter @atria/web start",
    "lint": "bun --filter '*' lint",
    "lint:fix": "bun --filter '*' lint:fix",
    "test": "bun --filter '*' test",
    "tokens:generate": "bun scripts/generate-tokens.ts",
    "tokens:check": "bun scripts/generate-tokens.ts --check",
    "mobile-tailwind:generate": "bun scripts/generate-mobile-tailwind-config.ts",
    "db:reset": "bun --filter @atria/web db:reset",
    "db:seed": "bun --filter @atria/web db:seed",
    "db:demo:reset": "bun --filter @atria/web db:demo:reset",
    "db:demo:verify": "bun --filter @atria/web db:demo:verify",
    "db:provision": "bun --filter @atria/web db:provision",
    "db:check-invariants": "bun --filter @atria/web db:check-invariants",
    "db:restore-drill": "bun --filter @atria/web db:restore-drill",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "tailwind:format": "bun --filter @atria/web tailwind:format",
    "storybook": "bun --filter @atria/web storybook",
    "build-storybook": "bun --filter @atria/web build-storybook"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  },
  "overrides": {
    "react-native-css-interop": "0.2.6"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
