# API service; this origin is never exposed as a browser RPC target.
API_ORIGIN=http://localhost:3001
# Match the API's bridge secret. Set locally; do not commit the value.
API_BRIDGE_SECRET=
# Add this exact origin to the API trusted origins.
# Configure ADMIN_ORIGIN=http://localhost:3002 in apps/api/.env.
# Optional timeout for server requests.
API_CALL_TIMEOUT_MS=60000
# Manual links to the existing mobile web app.
NEXT_PUBLIC_ATRIA_WEB_URL=http://localhost:3000
