{
  "name": "@atria/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/api-types/apps/api/src/contracts.d.ts"
    },
    "./contract": {
      "types": "./dist/api-types/apps/api/src/contracts.d.ts"
    },
    "./types/*": {
      "types": "./dist/api-types/apps/api/src/backend/*.d.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "types:api": "tsc -p tsconfig.api.json && bun scripts/relativize-api-types.ts",
    "lint": "eslint src scripts drizzle.config.ts",
    "lint:fix": "eslint src scripts drizzle.config.ts --fix",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:reset": "bun scripts/reset-database.ts",
    "db:seed": "bun src/backend/db/seed.ts",
    "db:seed:bassura": "bun scripts/seed-bassura-to-b3.ts",
    "db:demo:reset": "bun scripts/reset-demo-database.ts",
    "db:demo:verify": "bun scripts/verify-demo-seed.ts",
    "db:provision": "bun scripts/provision-instance.ts",
    "db:check-invariants": "bun scripts/check-invariants.ts",
    "db:restore-drill": "bun scripts/restore-drill.ts",
    "perf:loaders": "bun scripts/perf-loaders.ts",
    "db:dev:seed": "bun scripts/seed-development-database.ts",
    "db:dev:reset": "bun scripts/seed-development-database.ts --reset",
    "db:dev:verify": "bun scripts/seed-development-database.ts --verify",
    "dev:local": "bun --preload ./scripts/development-postgres-preload.ts --watch src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@atria/core": "workspace:*",
    "@better-auth/expo": "^1.6.29",
    "@google/genai": "^2.8.0",
    "@imagekit/nodejs": "7.12.1",
    "@neondatabase/serverless": "^1.1.0",
    "@trpc/server": "^11.18.0",
    "ai": "^7.0.65",
    "better-auth": "^1.6.29",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.12",
    "pdf-parse": "2.4.5",
    "sharp": "0.35.5",
    "superjson": "^2.2.6",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "1.3.14",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "pg": "^8.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "@trpc/client": "^11.18.0"
  }
}
