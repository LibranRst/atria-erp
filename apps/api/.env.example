NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-an-instance-specific-random-secret
API_BRIDGE_SECRET=local-development-only-api-bridge-secret
# Use a development/test database; never copy production credentials into tests.
DATABASE_URL=postgresql://USER:PASSWORD@DEVELOPMENT-NEON-HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT-NEON-HOST/DATABASE?sslmode=require
ATRIA_DEV_ACCOUNT_SWITCHER_ENABLED=false
# Existing optional provider settings belong to this API process:
# GEMINI_API_KEY, DEEPSEEK_API_KEY, NINEROUTER_API_KEY/NINEROUTER_BASE_URL
# IMAGEKIT_PRIVATE_KEY, NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY, NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT
# CRON_SECRET, NOTIFICATION_JOB_SECRET
# WEB_PUSH_VAPID_PUBLIC_KEY, WEB_PUSH_VAPID_PRIVATE_KEY, WEB_PUSH_SUBJECT

# Required for private attachments; use your own ImageKit account endpoint.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
# Fail closed for confidential pilot data until each provider is reviewed.
ATRIA_PILOT_REAL_DATA=false
AI_CHAT_PROVIDERS=NINEROUTER
AI_APPROVED_PROVIDERS=
GEMINI_PAID_DATA_POLICY_CONFIRMED=false
