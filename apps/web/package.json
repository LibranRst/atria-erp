{
  "name": "@atria/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-lan.mjs",
    "dev:preset": "node scripts/dev-lan.mjs",
    "dev:default": "next dev",
    "build": "bun run types:api && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "types:api": "bun run --filter @atria/api types:api",
    "test": "bun test",
    "tailwind:canonical": "eslint app components features --fix --no-warn-ignored",
    "tailwind:format": "bun run tailwind:canonical && prettier --write \"{app,components,features}/**/*.{js,jsx,ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "bun run types:api && tsc --noEmit",
    "predev": "bun run types:api",
    "browser:test": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.68",
    "@atria/api": "workspace:*",
    "@atria/core": "workspace:*",
    "@atria/icons": "workspace:*",
    "@atria/tokens": "workspace:*",
    "@floating-ui/react": "^0.27.20",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hugeicons/react": "1.1.10",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/overlays": "3.32.1",
    "ai": "^7.0.65",
    "better-auth": "^1.6.29",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "html2canvas-pro": "^2.4.2",
    "next": "16.3.6",
    "pdf-lib": "1.17.1",
    "react": "19.2.4",
    "react-aria": "3.52.1",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@atria/api-client": "workspace:*",
    "@hugeicons/core-free-icons": "4.3.5",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "1.56.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/nextjs": "10.5.5",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.14",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-tailwind-canonical-classes": "^1.4.1",
    "happy-dom": "^20.8.4",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "server-only": "^0.0.1",
    "storybook": "10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
