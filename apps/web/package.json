{
  "name": "@atria/web",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": {
      "types": "./dist/api-types/apps/web/server/trpc/root.d.ts",
      "default": "./server/trpc/root.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-lan.mjs",
    "dev:default": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "types:api": "tsc -p tsconfig.api.json",
    "test": "bun test",
    "db:reset": "bun scripts/reset-database.ts",
    "db:seed": "bun db/seed.ts",
    "db:demo:reset": "bun scripts/reset-demo-database.ts",
    "db:demo:verify": "bun scripts/verify-demo-seed.ts",
    "db:generate": "drizzle-kit generate",
    "tailwind:canonical": "eslint app components features --fix --no-warn-ignored",
    "tailwind:format": "bun run tailwind:canonical && prettier --write \"{app,components,features}/**/*.{js,jsx,ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/react": "^4.0.68",
    "@atria/core": "workspace:*",
    "@atria/tokens": "workspace:*",
    "@better-auth/expo": "^1.6.29",
    "@google/genai": "^2.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@trpc/server": "^11.18.0",
    "ai": "^7.0.65",
    "better-auth": "^1.6.29",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/nextjs": "10.5.5",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-tailwind-canonical-classes": "^1.4.1",
    "mini-css-extract-plugin": "2.10.2",
    "pg": "^8.21.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "server-only": "^0.0.1",
    "storybook": "10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
