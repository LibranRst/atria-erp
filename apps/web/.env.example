# Server-only API origin and bridge secret. Use the same bridge secret as apps/api.
API_ORIGIN="http://localhost:3001"
API_BRIDGE_SECRET="local-development-only-api-bridge-secret"
API_CALL_TIMEOUT_MS="60000"

# Public frontend URL. Auth stays same-origin through /api/auth forwarding.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Historic stored attachment-reference origins only; never auth/CORS permissions.
WEB_ADDITIONAL_ORIGINS=
# Enable only for the approved pilot build; bank values represent its cutoff plus pilot activity.
NEXT_PUBLIC_ATRIA_PILOT_MODE="false"

# Public ImageKit upload key. The API owns the private signing key.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_YourImageKitPublicKeyHere"

# Development-only account simulation; production ignores this flag.
ATRIA_DEV_ACCOUNT_SWITCHER_ENABLED="false"

# Database/auth/AI/worker credentials belong exclusively in apps/api/.env.
NODE_ENV="development"
