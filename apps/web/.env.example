# Database Configuration
DATABASE_URL="postgres://username:password@ep-host-name.region.neon.tech/dbname?sslmode=require"

# Database khusus integration test. `bun run test` TIDAK menyentuh Postgres
# selama variabel ini kosong: suite yang memanggil Server Action asli akan
# di-skip, dan DATABASE_URL diarahkan ke alamat buntu supaya koneksi yang
# tidak sengaja gagal cepat alih-alih mengotori data development.
#
# Isi hanya dengan database sekali pakai yang sudah di-seed lewat
# `bun run db:demo:reset`; suite tersebut menulis ke fixture seed dan tidak
# memulihkan seluruh state-nya.
# ATRIA_TEST_DATABASE_URL="postgres://username:password@ep-test-host.region.neon.tech/dbname?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="super-secret-random-key-at-least-32-characters"

# Bootstrap Owner pertama lewat route /setup pada database kosong.
# Minimal 16 karakter. Tanpa nilai ini, /setup selalu menolak dengan FORBIDDEN.
ATRIA_BOOTSTRAP_SECRET="bootstrap-secret-at-least-16-chars"

# Development-only account simulation. Production always ignores this flag.
ATRIA_DEV_ACCOUNT_SWITCHER_ENABLED="false"
# Optional deterministic demo-seed anchor for automated tests (YYYY-MM-DD).
# ATRIA_DEMO_SEED_DATE="2026-07-22"
BETTER_AUTH_URL="http://localhost:3000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ImageKit (unggah nota lapangan, cover proyek, dan foto profil)
#
# Private key dipakai server untuk menandatangani setiap unggahan; ia tidak
# pernah dikirim ke peramban. Public key ikut terkirim dalam setiap unggahan dan
# memang tidak rahasia — tanpa nilai ini kode memakai public key bawaan yang
# tertulis di `lib/media/upload-to-imagekit.ts`.
IMAGEKIT_PRIVATE_KEY="private_YourImageKitPrivateKeyHere"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_YourImageKitPublicKeyHere"

# AI Integration
#
# 9Router adalah penyedia utama AI chat agent (kompatibel format OpenAI).
# Menggunakan endpoint 9Router lokal atau remote dengan model Gemini 3.8 Flash High (ag/gemini-3.8-flash-high)
# serta reasoning_effort high.
#
# DeepSeek V4 Flash adalah cadangan pertama; Gemini dipakai sebagai cadangan
# terakhir ketika DeepSeek gagal (kredit habis, rate limit, gangguan layanan).
# Gemini juga tetap menjadi model OCR nota.
#
# OpenRouter tetap didukung sebagai opsi cadangan jika dikonfigurasi.
#
# Tanpa NINEROUTER_API_KEY / NINEROUTER_BASE_URL, chat otomatis jatuh ke DeepSeek.
# Tanpa DeepSeek, chat jatuh ke Gemini.
NINEROUTER_API_KEY="sk-Your9RouterApiKeyHere"
NINEROUTER_BASE_URL="http://localhost:20128/v1"
NINEROUTER_MODEL_ID="ag/gemini-3.8-flash-high"
NINEROUTER_REASONING_EFFORT="high"
DEEPSEEK_API_KEY="sk-YourDeepSeekApiKeyHere"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
OPENROUTER_API_KEY="sk-or-v1-YourOpenRouterApiKeyHere"

# Node Environment
NODE_ENV="development"

# Server-only bearer secret for generic POST calls to /api/internal/notifications.
NOTIFICATION_JOB_SECRET=

# Vercel automatically sends CRON_SECRET for the configured reconciliation and delivery GET jobs.
CRON_SECRET=

# Web Push VAPID identity. Generate one stable pair per deployment/environment.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com
