# URL absolut server Next yang dapat dijangkau perangkat fisik lewat LAN.
# Jika kosong saat development, aplikasi mengambil host Metro dan memakai port 3000.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Public key ImageKit untuk unggah langsung bukti transaksi. Private key tetap hanya di server.
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxx=

# Opsional untuk bukti koneksi otomatis pada data seed lokal. Jangan isi di build produksi.
# EXPO_PUBLIC_DEMO_EMAIL=ronald@dekoria.com
# EXPO_PUBLIC_DEMO_PASSWORD=password123
# EXPO_PUBLIC_VERIFY_DEMO=true
