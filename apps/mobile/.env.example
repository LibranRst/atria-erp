# URL API mandiri yang dapat dijangkau perangkat fisik lewat LAN.
# Jika kosong saat development, aplikasi mengambil host Metro dan memakai port 3001.
# Build non-development wajib memakai URL API eksplisit.
EXPO_PUBLIC_API_URL=
# Contoh override LAN: http://192.168.1.100:3001

# URL frontend web untuk fitur yang belum tersedia native. Web tidak ikut dev:mobile.
# Jika kosong saat development, memakai host Metro pada port 3000.
# Build non-development wajib memakai URL web eksplisit saat membuka fitur web.
EXPO_PUBLIC_WEB_URL=
# Contoh override LAN: http://192.168.1.100:3000

# Public key ImageKit untuk unggah langsung bukti transaksi. Private key tetap hanya di server.
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxx=

# Opsional untuk bukti koneksi otomatis pada data seed lokal. Jangan isi di build produksi.
# EXPO_PUBLIC_DEMO_EMAIL=ronald@dekoria.com
# EXPO_PUBLIC_DEMO_PASSWORD=password123
# EXPO_PUBLIC_VERIFY_DEMO=true
