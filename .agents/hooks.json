{
  "safety-gate": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/antigravity-pre-tool.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "atria-invariants-reminder": {
    "enabled": false,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/antigravity-reminder.mjs",
        "timeout": 5
      }
    ]
  }
}

